      "id": "c84bffa0-7940-48c9-8627-54320bc60c93",
      "name": "Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are writing a short-form video script for a talking-head presenter.\n\nTopic: {{ $json.topic }}\nAudience: {{ $json.audience }}\nTone: {{ $json.tone }}\nTarget length: {{ $json.target_seconds }} seconds when read aloud at a natural pace (roughly {{ $json.target_seconds * 2.5 }} words total).\n\nRules:\n- The hook must land in the first 3 seconds and must not begin with a greeting or \"In this video\".\n- Write for the ear, not the page: short sentences, no bullet points, no headings, no stage directions, no emoji.\n- Use concrete numbers or a specific example rather than general claims.\n- The CTA is one sentence and asks for a comment or a follow, not a purchase.\n- The title is under 60 characters and is not clickbait.\n- The description opens with one sentence summarising the video.\n- Give 5 to 8 lowercase tags, no hashes.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -192,
        -64
      ],
      "id": "626dfe4b-92f2-42bf-b55f-c615ed39c566",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.8
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        -224,
        144
      ],
      "id": "33fd40c9-43fb-4bd1-a1f6-25a7f9ee58ec",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "KdfMGMAAN0lsGo7a",
          "name": "Gemini — avatar pipeline"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"hook\": \"Your retirement calculator just lied to you about inflation.\",\n  \"body\": \"Most calculators assume a flat three percent. Real Indian CPI over the last decade swung between four and seven. On a thirty year horizon that gap is the difference between retiring at sixty and retiring at sixty-eight. Here is what to do instead: run your number three times, at four percent, six percent, and eight percent, and plan for the middle one.\",\n  \"cta\": \"What rate does your calculator default to? Tell me in the comments.\",\n  \"title\": \"Your retirement calculator is lying about inflation\",\n  \"description\": \"Most retirement calculators assume a flat inflation rate that has not matched reality for a decade. Here is a three-scenario approach that gives you an honest number.\",\n  \"tags\": [\"retirement\", \"inflation\", \"personal finance\", \"investing\", \"financial planning\"],\n  \"estimated_seconds\": 58\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        0,
        144
      ],
      "id": "2fa29f3e-53e9-42d3-b054-ace3552c8bc5",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c500fa26-e007-4649-be59-168ea1ee468b",
              "name": "topic",
              "value": "={{ $('Input').item.json.topic }}",
              "type": "string"
            },
            {
              "id": "bd6caa42-2a7b-4f61-89b0-fac14b511014",
              "name": "hook",
              "value": "={{ $json.output.hook }}",
              "type": "string"
            },
            {
              "id": "55a8afda-bfe7-4a12-bc3c-d0e3cffa2516",
              "name": "body",
              "value": "={{ $json.output.body }}",
              "type": "string"
            },
            {
              "id": "1362742d-3895-4cb3-b44c-981db53bfb5c",
              "name": "cta",
              "value": "={{ $json.output.cta }}",
              "type": "string"
            },
            {
              "id": "e626ed0a-757d-4e3b-856c-700aa4ee5de3",
              "name": "title",
              "value": "={{ $json.output.title }}",
              "type": "string"
            },
            {
              "id": "e6e4506e-811a-4423-b6b2-c231c71fe08d",
              "name": "description",
              "value": "={{ $json.output.description + \"\\n\\n---\\nThis video features an AI-generated presenter.\" }}",
              "type": "string"
            },
            {
              "id": "7d1e1fca-d57f-444c-9586-fd8e715d7634",
              "name": "tags",
              "value": "={{ $json.output.tags }}",
              "type": "array"
            },
            {
              "id": "a51fc941-b357-41df-8504-4e55fcfefc94",
              "name": "narration",
              "value": "={{ $json.output.hook }} {{ $json.output.body }} {{ $json.output.cta }}",
              "type": "string"
            },
            {
              "id": "716406d7-ad9b-4766-bd8d-f1f049618cef",
              "name": "slug",
              "value": "={{ $json.output.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') }}",
              "type": "string"
            },
            {
              "id": "f8d2fbec-7e79-4eb8-8e06-eab3727eeabe",
              "name": "generated_at",
              "value": "={{ $now.toISO() }}",
