    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst fields = r.data ?? r;                       // form answers\nconst pick = name => {\n  const key = Object.keys(fields).find(k => k.toLowerCase() === name);\n  return key ? fields[key] : undefined;\n};\n\nlet decision = String(pick('decision') ?? '').trim().toLowerCase();\nif (!['approve', 'reject', 'regenerate'].includes(decision)) decision = 'expired';   // no answer in 24h\n\nconst STATUS = { approve: 'approved', reject: 'rejected', regenerate: 'pending', expired: 'review_expired' };\n\nreturn [{ json: {\n  row_number: $('Input').first().json.row_number,\n  decision,\n  status: STATUS[decision],\n  notes: String(pick('notes') ?? '').trim(),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
