    {
      "parameters": {
        "jsCode": "// Reject bad input loudly instead of letting the LLM invent content.\nconst item = $input.first().json;\nconst topic = String(item.topic ?? '').trim();\n\nif (topic.length < 5) {\n  throw new Error(\n    `Row ${item.row_number}: topic is missing or too short (\"${topic}\")`\n  );\n}\n\nif (!item.target_seconds || item.target_seconds < 15 || item.target_seconds > 180) {\n  throw new Error(\n    `Row ${item.row_number}: target_seconds must be between 15 and 180, got ${item.target_seconds}`\n  );\n}\n\nreturn [{ json: { ...item, topic } }];"
      },
