      "id": "b0b8138e-0e0e-4d55-b2fe-b25a1160989f",
      "name": "Wait Before Poll",
      "webhookId": "05514e94-1e8e-43f1-8185-ee608b3a7ba6"
    },
    {
      "parameters": {
        "jsCode": "// MOCK — replaced by a real HTTP GET on Day 8.\nconst job = $('Submit Render').first().json;\nconst now = Date.now();\n\nlet status;\nif (job.will_fail)             status = 'failed';\nelse if (now >= job.finishes_at) status = 'completed';\nelse                             status = 'processing';\n\nreturn [{\n  json: {\n    job_id:  job.job_id,\n    status,\n    attempt: $runIndex + 1,          // 0-based, so +1 reads naturally in logs\n    elapsed_seconds: Math.round((now - job.submitted_at) / 1000),\n    video_url: status === 'completed'\n      ? `https://example.com/renders/${job.job_id}.mp4`\n      : null,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
