      "parameters": {
        "jsCode": "// MOCK — replaced by a real HTTP POST to HeyGen on Day 8.\n// A real submit returns a job/video ID and nothing else useful.\n\nconst config = $input.first().json;\n\n// pretend this render takes 18 seconds\nconst RENDER_MS = 18000;\n\nreturn [{\n  json: {\n    job_id: 'job_' + Math.random().toString(36).slice(2, 10),\n    submitted_at: Date.now(),\n    finishes_at: Date.now() + RENDER_MS,\n    will_fail: config.simulate_failure,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -32
      ],
      "id": "00816a91-ae4f-44b7-9f68-0baa5a644e3f",
      "name": "Submit Render"
    },
