    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst path = String(item.video_path ?? '').trim();\nif (!path.startsWith('/files/video/') || !path.endsWith('.mp4')) {\n  throw new Error(`Row ${item.row_number}: video_path looks wrong (\"${path}\")`);\n}\nconst words = String(item.narration ?? '').trim().split(/\\s+/).filter(Boolean);\nconst total = Number(item.video_seconds);\nif (!words.length || !(total > 0)) {\n  throw new Error(`Row ${item.row_number}: need narration and video_seconds to build captions`);\n}\n\nconst WORDS_PER_CUE = 5;\nconst chunks = [];\nfor (let i = 0; i < words.length; i += WORDS_PER_CUE) {\n  chunks.push(words.slice(i, i + WORDS_PER_CUE).join(' '));\n}\n\n// each chunk gets screen time in proportion to its length\nconst totalChars = chunks.reduce((sum, c) => sum + c.length, 0);\nlet t = 0;\nconst cues = chunks.map(text => {\n  const dur = total * text.length / totalChars;\n  const cue = { start: Number(t.toFixed(2)), end: Number((t + dur).toFixed(2)), text };\n  t += dur;\n  return cue;\n});\n\nreturn [{ json: { ...item, video_path: path, cues, cue_count: cues.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
