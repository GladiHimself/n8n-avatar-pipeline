    {
      "parameters": {
        "promptType": "define",
        "text": "=Write thumbnail text and hashtags for a YouTube Short.\n\nTitle: {{ $json.title }}\nTopic: {{ $json.topic }}\n\nRules:\n- thumbnail_text: 2 to 4 words, punchy, readable at a glance, no emojis, no misleading clickbait\n- hashtags: exactly 3, relevant to the topic, lowercase, no spaces",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -528,
        -16
      ],
      "id": "8676bb33-f74e-4b23-8a9e-2924a36d36c5",
      "name": "Thumbnail Copy"
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        -592,
        176
      ],
      "id": "c972245c-e34c-4dc9-846c-628315516d45",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "KdfMGMAAN0lsGo7a",
          "name": "Gemini — avatar pipeline"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \n  \"thumbnail_text\": \"Save Before You Spend\", \n  \"hashtags\": [\"#personalfinance\", \"#savingmoney\", \"#moneytips\"] \n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -320,
        176
      ],
      "id": "fa71ce25-669f-408b-adef-918f0db9a24b",
      "name": "Structured Output Parser",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const src = $('Input').first().json;\nconst ai = $input.first().json.output ?? {};\nconst DISCLOSURE = 'This video features an AI-generated presenter.';\nconst clean = s => String(s ?? '').replace(/[<>]/g, '').trim();   // YouTube rejects < and >\n\n// Title: max 100 characters\nlet title = clean(src.title);\nif (title.length > 100) title = title.slice(0, 97).trimEnd() + '...';\n\n// Hashtags: #Shorts first, no spaces/symbols, no duplicates, max 5\nconst hashtags = ['#Shorts', ...(ai.hashtags ?? [])]\n  .map(h => '#' + String(h).replace(/^#/, '').replace(/[^\\p{L}\\p{N}_]/gu, ''))\n  .filter(h => h.length > 1)\n  .filter((h, i, all) => all.findIndex(x => x.toLowerCase() === h.toLowerCase()) === i)\n  .slice(0, 5);\n\n// Description: disclosure guaranteed, hashtags at the end, max 5000 characters\nlet description = clean(src.description);\nif (!description.includes(DISCLOSURE)) description += `\\n\\n---\\n${DISCLOSURE}`;\ndescription = `${description}\\n\\n${hashtags.join(' ')}`.slice(0, 5000);\n\n// Tags: total must stay under 500 characters (tags with spaces count 2 extra for quotes)\nconst rawTags = Array.isArray(src.tags) ? src.tags : String(src.tags ?? '').split(',');\nconst tags = [];\nlet used = 0;\nfor (const tag of rawTags.map(clean).filter(Boolean)) {\n  const cost = tag.length + (tag.includes(' ') ? 2 : 0) + (tags.length ? 1 : 0);\n  if (used + cost > 500) break;\n  tags.push(tag);\n  used += cost;\n}\n\nconst thumbnail_text = clean(ai.thumbnail_text) || title.split(' ').slice(0, 4).join(' ');\n\nreturn [{ json: {\n  row_number: src.row_number,\n  slug: src.slug,\n  yt_title: title,\n  yt_description: description,\n  yt_tags: tags,\n  yt_category_id: '22',\n  thumbnail_text,\n  hashtags,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        -16
      ],
